# Copy to .env for local development (loaded automatically by settings.py).
# Production: set these in the real environment; do not rely on DEBUG=True.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Used when DJANGO_DEBUG=False (safe production defaults):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Optional upload limits (bytes):
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
# DJANGO_MAX_LESSON_MODEL_BYTES=20971520
# DJANGO_MAX_COURSE_THUMBNAIL_BYTES=2097152
