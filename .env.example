# Copy to .env for local development (loaded automatically by settings.py).
# Production: set these in the real environment; do not rely on DEBUG=True.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Docker Compose only. Leave unset for a plain SQLite `runserver`.
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://learning:change-me@db:5432/learning

# Used when DJANGO_DEBUG=False (safe production defaults):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Behind PythonAnywhere / other reverse proxies, SECURE_PROXY_SSL_HEADER is set in code.

# Serve uploaded media from local MEDIA_ROOT (True for PythonAnywhere disk).
# DJANGO_SERVE_MEDIA=True

# Login brute-force limits:
# DJANGO_LOGIN_ATTEMPT_LIMIT=5
# DJANGO_LOGIN_ATTEMPT_WINDOW=300

# API throttle rates (DRF):
# DJANGO_THROTTLE_ANON=60/min
# DJANGO_THROTTLE_USER=120/min

# Optional upload limits (bytes):
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
# DJANGO_MAX_LESSON_MODEL_BYTES=20971520
# DJANGO_MAX_COURSE_THUMBNAIL_BYTES=2097152
