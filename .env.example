# Copy to .env for local development (loaded automatically by settings.py).
# Production: set these in the real environment; do not rely on DEBUG=True.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Used when DJANGO_DEBUG=False (safe production defaults):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
